{
  "model": "sonnet",
  "advisorModel": "opus",
  "effortLevel": "high",
  "permissions": {
    "ask": [
      "Bash(npx:*)",
      "Bash(bunx:*)",
      "Bash(pnpm dlx:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git clone:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(conda install:*)",
      "WebFetch",
      "Bash(python src/main.py:*)",
      "Bash(python3 src/main.py:*)",
      "Bash(python src/ezbot.py:*)",
      "Bash(python3 src/ezbot.py:*)",
      "Bash(python src/agents/*)",
      "Bash(python ./src/agents/*)",
      "Bash(python src/nice_funcs*)",
      "Bash(python -m src.agents*)",
      "Bash(python3 src/agents/*)",
      "Bash(python3 ./src/agents/*)",
      "Bash(python3 src/nice_funcs*)",
      "Bash(python3 -m src.agents*)"
    ],
    "deny": [
      "Bash(curl * | sh:*)",
      "Bash(curl * | bash:*)",
      "Bash(wget * | sh:*)",
      "Bash(wget * | bash:*)"
    ]
  },
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
